# Produits de compilation — tout est reconstructible par ./build.sh, et vérifiable par
# ./check.sh.
.build/
.swiftpm/
DerivedData/
*.app
*.dmg

# Réglages personnels d'éditeur et d'outillage
#
# `.vscode/launch.json` est régénéré par l'extension Swift et se réécrit tout seul au
# moindre déplacement de fichier. Le suivre ne partageait rien d'utile — il gardait des
# configurations mortes vers des cibles supprimées — et salissait chaque diff.
.vscode/
.claude/settings.local.json
*.xcuserstate
xcuserdata/

# Ce que les essais et les exports laissent tomber. Un CSV d'identifiants est **en clair** :
# le mettre dans un dépôt serait la pire façon possible de perdre un mot de passe.
identifiants-wuji.csv
*.entitlements
/tmp-*
coffre.json

# Métadonnées que macOS sème
.DS_Store
._*
.Spotlight-V100
.Trashes

# `Package.resolved` **est** suivi, et volontairement : il fige les versions des
# dépendances, donc deux machines compilent le même navigateur. L'ignorer rendrait les
# différences de comportement inexplicables.

# L'identité de signature d'une machine — celle de son propriétaire, pas celle du dépôt.
.identite-signature
