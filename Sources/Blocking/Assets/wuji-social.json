  {"action":{"type":"block"},"trigger":{"url-filter":"^[^:]+://+([^:/]+\\.)?analytics\\.pointdrive\\.linkedin\\.com[/:]"}},
  {"action":{"type":"block"},"trigger":{"url-filter":"^[^:]+://+([^:/]+\\.)?ads\\.pinterest\\.com[/:]"}},
  {"action":{"type":"block"},"trigger":{"url-filter":"^[^:]+://+([^:/]+\\.)?log\\.pinterest\\.com[/:]"}},
  {"action":{"type":"block"},"trigger":{"url-filter":"^[^:]+://+([^:/]+\\.)?trk\\.pinterest\\.com[/:]"}},
  {"action":{"type":"block"},"trigger":{"url-filter":"^[^:]+://+([^:/]+\\.)?events\\.reddit\\.com[/:]"}},
