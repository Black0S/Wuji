<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Wuji</string>
	<key>CFBundleDisplayName</key>
	<string>Wuji</string>
	<key>CFBundleIdentifier</key>
	<string>com.wuji.browser</string>
	<key>CFBundleExecutable</key>
	<string>Wuji</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<!-- Sans ces descriptions, une page qui demande la caméra ou le micro échoue en
	     silence. C'est aussi ce que le liseré « permission active » doit signaler. -->
	<!-- Sans cette déclaration, macOS ne propose même pas Wuji dans la liste des
	     navigateurs : on ne peut pas devenir le navigateur par défaut si l'on n'a jamais
	     dit qu'on savait ouvrir une adresse. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Adresse web</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Un site web demande l'accès à la caméra.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Un site web demande l'accès au microphone.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Un site web demande votre position.</string>
</dict>
</plist>
