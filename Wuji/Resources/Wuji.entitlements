<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sans lui, WebKit refuse d'ouvrir son inspecteur : une application signée qui
	     n'autorise pas le débogage n'est pas inspectable, et le réglage « Autoriser
	     l'inspection Safari » restait sans effet. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
